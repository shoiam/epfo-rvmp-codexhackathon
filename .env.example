# Neon pooled connection string for application queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/epfo?sslmode=require"

# Neon direct connection string for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/epfo?sslmode=require"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"
